node_modules/
*/node_modules/
.pnpm-store/
.yarn/cache/
.yarn/unplugged/
.yarn/build-state.yml
.yarn/install-state.gz
.pnp.*

# ==========================================
# BUILD OUTPUTS & COMPILATION ARTIFACTS
# ==========================================
dist/
*/dist/
build/
*/build/
.next/
frontend/.next/
out/
frontend/out/
.vercel/

# ==========================================
# ENVIRONMENT VARIABLES & SECRETS
# ==========================================
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
frontend/.env
frontend/.env.local
frontend/.env.development.local
frontend/.env.test.local
frontend/.env.production.local
*.pem
*.key
*.cert
*.crt

# Keep example templates committed
!.env.example
!frontend/.env.example

# ==========================================
# DATABASES & LOCAL STORAGE
# ==========================================
*.db
*.db-journal
*.sqlite
*.sqlite3
pgdata/
docker-data/

